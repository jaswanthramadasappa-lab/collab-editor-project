# Stage 1: Build React Vite app
FROM node:22-alpine AS builder

WORKDIR /app

# Copy root and workspace package files for deterministic dependency resolution
COPY package*.json ./
COPY client/package.json ./client/package.json
COPY server/package.json ./server/package.json

RUN npm install

COPY client ./client

# Build arguments for API and WebSocket URLs
ARG VITE_API_URL=http://localhost:5000
ARG VITE_COLLAB_URL=ws://localhost:1234

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_COLLAB_URL=$VITE_COLLAB_URL

RUN npm run build -w client

# Stage 2: Serve built assets with Nginx
FROM nginx:alpine

COPY --from=builder /app/client/dist /usr/share/nginx/html
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
